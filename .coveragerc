[run]
source = astock
omit =
    astock/ui.py
    astock/charts.py
    astock/*_ui.py
    astock/backtest_chart.py

[report]
show_missing = True
skip_empty = True
precision = 2
# 覆盖率门槛按实测重设（plan-20261103-012），旧值 50% 早已低于实际水平，形同虚设。
#
# 实测基线（同一 commit，`coverage run -m pytest tests -q -m "not png"`）：
#   PR #21 CI Linux（2026-11-17, run 43928703294）：9247 stmts / 2176 miss = 76.47%（门禁权威值）
#   本地 Windows（Python 3.13.5，同一 commit，606 passed）：9247 / 2155 = 76.70%
#   本地改造前同机（558 passed）：9247 / 2156 = 76.68%
#   main CI Linux（2026-11-16, run 43923401645，旧代码）：9266 / 2188 = 76.39%
# 平台差异来源：Linux 上有 1 个用例按平台跳过（558/557 passed 之差），部分分支不执行。
# 门槛取 CI 实测显示值 76.47（精确 76.468%）：coverage 的 fail-under 比对用的是按 precision
# 四舍五入后的百分比（本地已验证：精确 76.6951% 可通过 --fail-under=76.70）。
# 因此门槛等于实测显示值即「不低于当前实测」，且任一语句回退会显示 76.46 → 直接红。
# 若未来 CI 实测低于该值，以 CI 日志百分比为准调整本行并在此注明，不得下调到实测值以下。
#
# 分阶段目标（同时写在 .github/workflows/ci.yml 的 step 注释里）：
#   P1（当前）：76.47% —— 等于 CI 实测显示值，任一语句回退即失败
#   P2：80% —— 补齐 agent 层与数据管道异常分支（见 coverage report 的 Missing 列）
#   P3：85% —— 覆盖 UI 之外的调度/推荐主流程
fail_under = 76.47
