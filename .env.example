# 复制为 .env 后填写；.env 已在 .gitignore 中
TUSHARE_TOKEN=your_tushare_token
# 自建/代理 Tushare 地址；留空则使用官方地址
TUSHARE_API_URL=http://your-tushare-proxy:8020
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE=https://api.deepseek.com
# 收盘后自动推荐（交易日）；设为 0 关闭，时间格式 HH:MM
ASTOCK_AUTO_RECOMMEND=1
ASTOCK_RECOMMEND_TIME=16:40

# ---- Agent 模型网关（ADR-014）----
# deepseek | openai_compatible | rule
# openai_compatible 可指向 Ollama / vLLM 等 OpenAI 兼容服务
AGENT_PROVIDER=deepseek
# 留空时 deepseek 使用 deepseek-chat；openai_compatible 必填
AGENT_MODEL=
# openai_compatible 必填，例如 http://localhost:11434/v1
AGENT_BASE_URL=
# 留空时回退 DEEPSEEK_API_KEY；本地 Ollama 可留空
AGENT_API_KEY=
AGENT_MAX_STEPS=12
AGENT_TOKEN_BUDGET=64000
# 单次请求超时（秒）
AGENT_TIMEOUT_SECONDS=60
# 每次调用的 JSONL 用量记录；留空时默认 data/agent/usage.jsonl
# AGENT_USAGE_LOG=data/agent/usage.jsonl
